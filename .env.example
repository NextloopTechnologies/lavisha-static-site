# Public URL of the site, used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://larishahealthcare.com

# Contact form → claims backend (POST /v1/leads). Server-only: never prefix with NEXT_PUBLIC_.
LEADS_API_URL=https://api.larishahealthcare.com/v1
# Must equal LEADS_API_KEY in the backend's environment.
LEADS_API_KEY=
